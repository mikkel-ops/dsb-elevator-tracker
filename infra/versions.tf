terraform {
  required_version = ">= 1.10"
  required_providers {
    aws = { source = "hashicorp/aws", version = "~> 6.0" }
  }
  # Partial config - run `terraform init -backend-config=backend.hcl`
  # (backend.hcl is generated by infra/bootstrap).
  backend "s3" {}
}

provider "aws" {
  region = var.region
  default_tags {
    tags = { Project = "dsb-elevator-tracker" }
  }
}

data "aws_caller_identity" "current" {}
